{
  "name": "projects-init-cli",
  "version": "2.6.0",
  "description": "CLI tool to initialize projects with customizable frontend, backend, and storage options",
  "main": "dist/index.js",
  "bin": {
    "projects-init": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "cli",
    "scaffold",
    "project-generator",
    "nextjs",
    "react",
    "express",
    "nestjs",
    "fastapi",
    "sequelize",
    "mongodb",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacAndersonUche/Projects-Init-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/MacAndersonUche/Projects-Init-CLI/issues"
  },
  "homepage": "https://github.com/MacAndersonUche/Projects-Init-CLI#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "inquirer": "^8.2.6",
    "chalk": "^4.1.2",
    "fs-extra": "^11.4.0"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^24.13.3",
    "@types/fs-extra": "^11.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.3",
    "ts-node": "^10.9.2",
    "vitest": "^4.1.10"
  }
}
